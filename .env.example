# DramaScan environment configuration.
#
# Copy this file to .env.local for local development and replace every
# CHANGE_ME value. Never commit real credentials, tokens, or secrets.
#
# Production requires every server-only secret below. Development may omit
# them until the dependent feature is used, but any value that is present is
# validated.

# ---------------------------------------------------------------- Application
# Public origin of the application. Production requires HTTPS.
APP_URL=http://localhost:3000

# Comma-separated additional browser origins allowed by authentication.
# APP_URL is always trusted and added automatically.
TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- PostgreSQL
# Server-only. The application role has DML rights only.
DATABASE_URL=postgresql://dramascan_app:CHANGE_ME@localhost:5432/dramascan

# Server-only. Used only by tests; the database name must end in _test and
# must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://dramascan_test:CHANGE_ME@localhost:5432/dramascan_test

# --------------------------------------------------------------- Better Auth
# Server-only. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# ---------------------------------------------------------------- Google OAuth
# Server-only. Create these in the Google Cloud console for the web application.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ------------------------------------------------------------ Administration
# Server-only. Google account email allowed to bootstrap the first Super Admin.
SUPER_ADMIN_EMAIL=admin@example.com
