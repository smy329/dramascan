# DramaScan environment configuration.
#
# Copy this file to .env.local for local development and replace every
# CHANGE_ME value. Never commit real credentials, tokens, or secrets.
#
# Production requires every server-only secret below. Development may omit
# them until the dependent feature is used, but any value that is present is
# validated.

# ---------------------------------------------------------------- Application
# Public origin of the application. Production requires HTTPS.
APP_URL=http://localhost:3000

# Comma-separated additional browser origins allowed by authentication.
# APP_URL is always trusted and added automatically.
TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- PostgreSQL
# Server-only. The application role has DML rights only.
DATABASE_URL=postgresql://dramascan_app:CHANGE_ME@localhost:5432/dramascan

# Server-only. Used only by tests; the database name must end in _test and
# must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://dramascan_test:CHANGE_ME@localhost:5432/dramascan_test

# --------------------------------------------------------------- Better Auth
# Server-only. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# ---------------------------------------------------------------- Google OAuth
# Server-only. Create these in the Google Cloud console for the web application.
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ------------------------------------------------------------ Logging
# Log level override. Overrides the default: `info` in production, `debug` in development.
# Valid values: `fatal`, `error`, `warn`, `info`, `debug`, `trace`
LOG_LEVEL=info

# ---------------------------------------------------------------- Super Admin
# Server-only. Google email eligible for the first-sign-in Super Admin bootstrap.
SUPER_ADMIN_EMAIL=

# Server-only. Read only by `npm run db:seed:super-admin`; stored as a hash.
# Must be at least 16 characters. Quote the value if it contains '#'.
SUPER_ADMIN_PASSWORD=

# ---------------------------------------------------------- Content visibility
# How a drama without a playable episode appears on the public site.
# `coming_soon` shows the poster, title, and description with no Play button.
# `hidden` hides the drama until a playable episode exists.
# A per-drama `visibility = hidden` is always the stricter rule.
EMPTY_DRAMA_VISIBILITY=coming_soon

# ------------------------------------------------------------------- Content Trash
# Default number of days trashed content is kept before the expiry maintenance
# command removes it permanently. Whole days between 1 and 365; default 30.
TRASH_RETENTION_DAYS=30

# ------------------------------------------------------------------ Image assets
# Directory that holds the original poster and banner uploads.
# Relative paths resolve against the application working directory.
#
# Development: `storage/images`, beside the project.
# Production: the directory must sit outside the application directory, because
# a deployment replaces the release directory and would delete the artwork
# stored inside it. Use the systemd state directory `/var/lib/dramascan/images`,
# which is the default on a Linux production host when this variable is absent.
# The directory is created on first upload.
IMAGE_STORAGE_DIR=storage/images
