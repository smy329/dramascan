{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.ts",
      "options": {
        "parser": "@typescript-eslint/parser"
      }
    },
    {
      "files": "*.tsx",
      "options": {
        "parser": "@typescript-eslint/parser"
      }
    }
  ]
}