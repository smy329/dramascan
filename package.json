{
  "name": "dramascan",
  "version": "0.1.0",
  "private": true,
  "description": "International drama and movie streaming platform.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern .next --ignore-pattern next.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:integration": "TEST_DATABASE_URL=postgresql://dramascan_test:CHANGE_ME@localhost:5432/dramascan_test vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:push": "npm run db:generate && npm run db:migrate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "prettier": "^3.0.2",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
