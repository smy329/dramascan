[Unit]
Description=DramaScan image delivery configuration
Documentation=file:/var/www/drama-scan/docs/architecture/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/var/www/drama-scan
# The original poster and banner files are stored on the application disk under
# IMAGE_STORAGE_DIR and are delivered by the application itself through
# /media/{kind}/{uuid}.{ext}. Nginx only proxies that route: it never resizes,
# converts, or re-encodes an image, and the image_filter module is not used.
ExecStart=/usr/bin/env bash -c '
set -euo pipefail

cat > /etc/nginx/sites-available/drama-scan-media << '\''EOF'\''
# DramaScan media delivery.
#
# The application serves the stored originals through /media/. The response
# already carries the immutable cache header and the content type of the
# stored file, so this location only forwards the request and preserves the
# headers. No image processing module is involved at any point.

location /media/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The stored filename is immutable, so the response may be cached for a
    # year. The application already sets this header; repeating it here makes
    # the guarantee explicit for operators reading only the Nginx config.
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;

    proxy_cache off;
    image_filter off;
}

# Stored artwork is never executable content.
location ~ ^/media/.*\.(php|pl|py|rb|sh|cgi)$ {
    deny all;
}
EOF

ln -sfn /etc/nginx/sites-available/drama-scan-media /etc/nginx/sites-enabled/drama-scan-media
nginx -t
systemctl reload nginx.service
'

RemainExitStatus=yes
